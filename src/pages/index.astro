---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import {
	formatDateForLocale,
	getAstroLocale,
	localizeEntry,
	localizedPath,
} from "../utils/i18n";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/home.css";

const locale = getAstroLocale(Astro);
const { entries, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
Astro.cache.set(cacheHint);

function contentType(entry: (typeof entries)[number]) {
	const data = entry.data as unknown as Record<string, unknown>;
	if (typeof data.content_type === "string" && data.content_type) return data.content_type;
	const family = String(data.framework_page ?? "");
	if (family === "the-method") return "journal";
	if (family === "the-doctrine") return "framework";
	if (family === "protocols") return "protocol";
	if (family === "standards") return "standard";
	return "journal";
}

function workPath(entry: (typeof entries)[number]) {
	const type = contentType(entry);
	if (type === "concept") return `/concepts/${entry.id}`;
	if (type === "framework") return `/system/frameworks/${entry.id === "doctrine" ? "paritsea-framework" : entry.id}`;
	if (type === "protocol") return `/system/protocols/${entry.id}`;
	if (type === "standard") return `/system/standards/${entry.id}`;
	return `/journal/${entry.id}`;
}

const works = entries.map((entry) => ({
	original: entry,
	entry: localizeEntry(entry, "posts", locale),
	type: contentType(entry),
	href: localizedPath(workPath(entry), locale),
}));

const featuredWorks = [
	works.find((item) => item.type === "journal"),
	works.find((item) => item.type === "framework"),
	works.find((item) => item.type === "protocol"),
	works.find((item) => item.type === "standard"),
].filter((item): item is NonNullable<typeof item> => Boolean(item));

function statusFor(item: (typeof works)[number]) {
	const data = item.original.data as unknown as Record<string, unknown>;
	return String(data.lifecycle_status ?? (item.type === "journal" ? "exploring" : "current"));
}

function versionFor(item: (typeof works)[number]) {
	const data = item.original.data as unknown as Record<string, unknown>;
	return String(data.document_version ?? (item.type === "journal" ? "0.1" : "1.0"));
}

const copy = locale === "th"
	? {
		pageDescription: "Paritsea รวมงานความคิดของ ปาริศ ฤทธิ์ชัย ที่ช่วยให้มองปัญหาใหม่ ศึกษาที่มา และนำไปปรับใช้โดยรู้ขอบเขตและเงื่อนไขการใช้",
		heroEyebrow: "งานความคิดต้นทางของ ปาริศ ฤทธิ์ชัย",
		heroTitle: ["Paritsea คือพื้นที่รวมแนวคิด", "ที่ช่วยให้มองปัญหาใหม่", "และนำไปใช้ได้จริง"],
		heroSummary: "ฉันรวบรวมข้อสังเกต วิธีมอง และงานที่ช่วยให้เห็นต้นเหตุของปัญหาชัดขึ้น ก่อนตัดสินใจว่าควรแก้อะไร งานแต่ละชิ้นระบุที่มา เวอร์ชัน และขอบเขตการใช้ เพื่อให้ศึกษาและนำไปปรับใช้โดยไม่ทำให้ความหมายต้นทางหายไป",
		heroAction: "สำรวจแนวคิดทั้งหมด",
		heroUseNote: "อ่านและศึกษาได้ · อ้างอิงโดยระบุที่มา · ขออนุญาตเมื่อนำไปใช้เชิงพาณิชย์",
		startEyebrow: "เลือกจากสิ่งที่ต้องการ",
		startTitle: "มาที่นี่เพื่อทำอะไร",
		startSummary: "ไม่ต้องเรียนรู้โครงสร้างของ Paritsea ก่อน เลือกจากสิ่งที่ต้องการทำ แล้วไปยังงานที่เกี่ยวข้องได้เลย",
		entrances: [
			{ number: "01", title: "อ่านมุมมองและคำถาม", body: "เริ่มจาก Journal เมื่อต้องการเห็นปัญหาจากมุมที่ต่างออกไป", action: "อ่าน Journal", href: "/journal" },
			{ number: "02", title: "ศึกษางานที่นำไปใช้ได้", body: "เลือก Framework, Protocol หรือ Standard เมื่อต้องการวิธีคิด เกณฑ์ หรือแนวทางที่จัดระบบแล้ว", action: "ดูงานที่นำไปใช้ได้", href: "/system" },
			{ number: "03", title: "ตรวจขอบเขตและสิทธิ์การใช้", body: "ดูว่าใช้ได้แค่ไหน ต้องให้เครดิตอย่างไร และกรณีใดควรติดต่อเพื่อขออนุญาต", action: "ดูวิธีใช้และสิทธิ์", href: "/ip/licensing" },
		],
		worksEyebrow: "งานที่เผยแพร่แล้ว",
		worksTitle: "เริ่มอ่านจากงานที่พร้อมใช้งาน",
		worksSummary: "แต่ละรายการระบุประเภท สถานะ และฉบับที่ใช้อ้างอิงได้ เพื่อให้แยกงานที่กำลังสำรวจออกจากงานที่จัดระบบแล้ว",
		worksAction: "ดูแนวคิดทั้งหมด",
		tableTitle: "ชื่อเรื่อง",
		tableType: "ประเภท",
		tableState: "ฉบับ / สถานะ",
		tableAction: "เปิดอ่าน",
		useEyebrow: "วิธีใช้และสิทธิ์",
		useTitle: "ใช้ได้แค่ไหน และเมื่อใดต้องขออนุญาต",
		useSummary: "จุดแบ่งไม่ใช่ว่าแนวคิดมีคนอ่านมากแค่ไหน แต่อยู่ที่งานนั้นถูกนำไปสร้างมูลค่าในบริบทใด",
		useLevels: [
			{ number: "01", title: "อ่าน ศึกษา และอ้างอิง", body: "อ่าน แบ่งปันลิงก์ และอ้างอิงโดยระบุชื่อผู้เขียนกับแหล่งที่มาได้ ภายใต้เงื่อนไขของงานแต่ละชิ้น", state: "ไม่ใช่การใช้เชิงพาณิชย์", tone: "open" },
			{ number: "02", title: "ทดลองหรือปรับใช้เพื่อประเมิน", body: "ใช้ภายในเพื่อเรียนรู้หรือประเมินความเหมาะสมได้บางกรณี แต่ต้องไม่อ้างว่าเป็นฉบับทางการหรือได้รับการรับรอง", state: "ตรวจเงื่อนไขของงาน", tone: "review" },
			{ number: "03", title: "ใช้สร้างมูลค่าเชิงพาณิชย์", body: "เมื่อแนวคิดกลายเป็นส่วนหนึ่งของสินค้า บริการ งานลูกค้า การอบรม เครื่องมือ หรือระบบที่สร้างรายได้ ต้องขออนุญาตก่อน", state: "ต้องขออนุญาต", tone: "permission" },
		],
		useAction: "อ่านเงื่อนไขและขออนุญาตใช้",
		useNote: "ค่าอนุญาตไม่ได้เกิดจากการอ่านแนวคิด แต่เกิดเมื่อมีการนำงานไปสร้างมูลค่าเชิงพาณิชย์ ขอบเขตและค่าอนุญาตพิจารณาจากวิธีใช้จริง",
		authorEyebrow: "ผู้เขียน",
		authorTitle: "ปาริศ ฤทธิ์ชัย",
		authorBody: "ฉันเป็นผู้เขียนงานใน Paritsea และดูแลการเปลี่ยนแปลงของฉบับต้นทาง เว็บไซต์นี้ทำให้งานเหล่านั้นค้น อ่าน และอ้างอิงได้ โดยไม่เปลี่ยนให้เป็นเว็บไซต์ขายบริการหรือประวัติส่วนตัว",
		authorAction: "รู้จักผู้เขียนและขอบเขตของ Paritsea",
		channelsEyebrow: "แต่ละช่องทางมีหน้าที่ต่างกัน",
		channels: [
			{ label: "YouTube", title: "ดูว่าฉันคิดอย่างไร", body: "มุมมอง เบื้องหลัง และกระบวนการที่เหมาะกับการเล่ามากกว่าการบันทึกเป็นเอกสาร", href: "https://www.youtube.com/@paritsea" },
			{ label: "SE Ocean", title: "ดูการนำไปแก้ปัญหาองค์กรจริง", body: "บริบทการประยุกต์ใช้บางส่วน ซึ่งเปลี่ยนตามสถานการณ์โดยไม่เปลี่ยนความหมายของงานต้นทาง", href: "https://seocean.co.th" },
		],
		workType: { journal: "Journal", concept: "Concept", framework: "Framework", protocol: "Protocol", standard: "Standard" } as Record<string, string>,
		status: { exploring: "กำลังสำรวจ", developing: "กำลังพัฒนา", current: "ฉบับปัจจุบัน", superseded: "มีฉบับใหม่กว่า", retired: "ยุติการใช้" } as Record<string, string>,
	}
	: {
		pageDescription: "Paritsea is the public home of Parit Ritchai's ideas: work for seeing problems differently, studying the source, and applying selected material within clear use boundaries.",
		heroEyebrow: "Source work by Parit Ritchai",
		heroTitle: ["Ideas for seeing a problem differently", "and choosing what to change."],
		heroSummary: "Paritsea brings together observations, lenses, and structured intellectual work that can be read, studied, and applied. Each work names its source, current version, and use boundary so the idea can travel without losing its meaning.",
		heroAction: "Explore all ideas",
		heroUseNote: "Read and study · Cite the source · Ask permission for commercial use",
		startEyebrow: "Choose by intent",
		startTitle: "What do you want to do with the work?",
		startSummary: "You do not need to learn Paritsea's internal structure first. Start with the action that brought you here.",
		entrances: [
			{ number: "01", title: "Read a perspective or question", body: "Start with Journal when you want to see a problem from a different angle.", action: "Read Journal", href: "/journal" },
			{ number: "02", title: "Study work you can apply", body: "Use Frameworks, Protocols, and Standards when you need a structured lens, method, or threshold.", action: "Browse applicable work", href: "/system" },
			{ number: "03", title: "Check use and permission", body: "See how to attribute the work, what adaptation permits, and when commercial use needs an agreement.", action: "Review use rights", href: "/ip/licensing" },
		],
		worksEyebrow: "Published work",
		worksTitle: "Start with work that is ready to use",
		worksSummary: "Each record states its type, status, and reference version so exploration remains distinct from governed work.",
		worksAction: "Browse all ideas",
		tableTitle: "Title",
		tableType: "Type",
		tableState: "Version / status",
		tableAction: "Open",
		useEyebrow: "Use and permission",
		useTitle: "What can you use, and when should you ask?",
		useSummary: "The boundary is not how widely an idea is read. It is how the work is being used to create value.",
		useLevels: [
			{ number: "01", title: "Read, study, and cite", body: "Read, share a link, and cite the author and source under the terms attached to each work.", state: "Not commercial use", tone: "open" },
			{ number: "02", title: "Test or adapt for evaluation", body: "Some internal learning and evaluation are permitted, but adaptation does not create official or endorsed status.", state: "Check the work's terms", tone: "review" },
			{ number: "03", title: "Use the work to create commercial value", body: "Permission is required when the work becomes part of a product, service, client engagement, training, tool, or revenue-generating system.", state: "Permission required", tone: "permission" },
		],
		useAction: "Read terms and request permission",
		useNote: "A fee is not triggered by reading an idea. It becomes relevant when the work is used to create commercial value. Scope and permission are considered against the actual use.",
		authorEyebrow: "Author",
		authorTitle: "Parit Ritchai",
		authorBody: "I write the work in Paritsea and remain responsible for changes to the source. The site makes that work findable, readable, and citable without becoming a service catalogue or personal portfolio.",
		authorAction: "Meet the author and understand Paritsea's boundary",
		channelsEyebrow: "Each channel has a different job",
		channels: [
			{ label: "YouTube", title: "See how I think", body: "Perspectives, background, and unfinished thinking that benefit from being spoken rather than documented here.", href: "https://www.youtube.com/@paritsea" },
			{ label: "SE Ocean", title: "See selected ideas applied to organizational problems", body: "Application contexts may change with the situation without redefining the Paritsea source.", href: "https://seocean.co.th" },
		],
		workType: { journal: "Journal", concept: "Concept", framework: "Framework", protocol: "Protocol", standard: "Standard" } as Record<string, string>,
		status: { exploring: "Exploring", developing: "Developing", current: "Current", superseded: "Superseded", retired: "Retired" } as Record<string, string>,
	};
---

<Base title={siteTitle} description={copy.pageDescription} locale={locale}>
	<div class="library-home">
		<section class="library-hero" aria-labelledby="home-title">
			<div class="library-hero-copy">
				<p class="library-eyebrow">{copy.heroEyebrow}</p>
				<h1 id="home-title">
					{copy.heroTitle.map((line, index) => <span>{line}{index < copy.heroTitle.length - 1 ? " " : ""}</span>)}
				</h1>
				<p class="library-hero-summary">{copy.heroSummary}</p>
				<div class="library-hero-actions">
					<a class="library-button" href={localizedPath("/journal", locale)}>
						{copy.heroAction}
					</a>
				</div>
				<p class="library-use-note">{copy.heroUseNote}</p>
			</div>
			<figure class="library-hero-figure">
				<img
					src="/images/home/paritsea-intellectual-volumes.webp"
					alt={locale === "th" ? "ชุดสมุด Journal, Framework, Protocol และ Standard" : "Four Paritsea volumes: Journal, Framework, Protocol, and Standard"}
					width="1448"
					height="1086"
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<section class="library-section library-start" aria-labelledby="start-title">
			<header class="library-section-heading">
				<div>
					<p class="library-eyebrow">{copy.startEyebrow}</p>
					<h2 id="start-title">{copy.startTitle}</h2>
				</div>
				<p>{copy.startSummary}</p>
			</header>
			<div class="library-entrances">
				{copy.entrances.map((entrance) => (
					<a class="library-entrance" href={localizedPath(entrance.href, locale)}>
						<span class="library-entrance-number" aria-hidden="true">{entrance.number}</span>
						<span class="library-entrance-copy">
							<strong>{entrance.title}</strong>
							<small>{entrance.body}</small>
						</span>
						<span class="library-inline-action">{entrance.action}</span>
					</a>
				))}
			</div>
		</section>

		<section class="library-section library-works" aria-labelledby="works-title">
			<header class="library-section-heading">
				<div>
					<p class="library-eyebrow">{copy.worksEyebrow}</p>
					<h2 id="works-title">{copy.worksTitle}</h2>
				</div>
				<div>
					<p>{copy.worksSummary}</p>
					<a class="library-text-link" href={localizedPath("/system", locale)}>{copy.worksAction}</a>
				</div>
			</header>
			<div class="library-work-index" role="table" aria-label={copy.worksTitle}>
				<div class="library-work-head" role="row">
					<span role="columnheader">{copy.tableTitle}</span>
					<span role="columnheader">{copy.tableType}</span>
					<span role="columnheader">{copy.tableState}</span>
					<span role="columnheader">{copy.tableAction}</span>
				</div>
				{featuredWorks.map((item) => (
					<a class="library-work-row" href={item.href} role="row">
						<span class="library-work-title" role="cell">
							<strong>{item.entry.data.title}</strong>
							{item.entry.data.excerpt && <small>{item.entry.data.excerpt}</small>}
						</span>
						<span class="library-work-type" role="cell" lang="en">{copy.workType[item.type]}</span>
						<span class="library-work-state" role="cell">
							{item.type === "journal" && item.original.data.publishedAt
								? formatDateForLocale(item.original.data.publishedAt, locale)
								: `v${versionFor(item)} · ${copy.status[statusFor(item)] ?? statusFor(item)}`}
						</span>
						<span class="library-work-action" role="cell"><span>{copy.tableAction}</span></span>
					</a>
				))}
			</div>
		</section>

		<section class="library-section library-use" aria-labelledby="use-title">
			<header class="library-use-heading">
				<p class="library-eyebrow">{copy.useEyebrow}</p>
				<h2 id="use-title">{copy.useTitle}</h2>
				<p>{copy.useSummary}</p>
			</header>
			<div class="library-use-levels">
				{copy.useLevels.map((level) => (
					<article class="library-use-level" data-tone={level.tone}>
						<span class="library-level-number">{level.number}</span>
						<div>
							<h3>{level.title}</h3>
							<p>{level.body}</p>
						</div>
						<strong class="library-level-state">{level.state}</strong>
					</article>
				))}
			</div>
			<div class="library-use-footer">
				<a class="library-button" href={localizedPath("/ip/licensing", locale)}>{copy.useAction}</a>
				<p>{copy.useNote}</p>
			</div>
		</section>

		<section class="library-section library-author" aria-labelledby="author-title">
			<figure class="library-author-portrait">
				<img
					src="/images/home/parit-ritchai-portrait.jpg"
					alt={locale === "th" ? "ปาริศ ฤทธิ์ชัย ผู้เขียน Paritsea" : "Parit Ritchai, author of Paritsea"}
					width="1440"
					height="1800"
					loading="lazy"
				/>
			</figure>
			<div class="library-author-copy">
				<p class="library-eyebrow">{copy.authorEyebrow}</p>
				<h2 id="author-title">{copy.authorTitle}</h2>
				<p>{copy.authorBody}</p>
				<a class="library-text-link" href={localizedPath("/about", locale)}>{copy.authorAction}</a>
			</div>
		</section>

		<section class="library-section library-channels" aria-labelledby="channels-title">
			<h2 id="channels-title" class="library-eyebrow">{copy.channelsEyebrow}</h2>
			<div class="library-channel-list">
				{copy.channels.map((channel) => (
					<a class="library-channel" href={channel.href} target="_blank" rel="noreferrer">
						<span class="library-channel-label" lang="en">{channel.label}</span>
						<span>
							<strong>{channel.title}</strong>
							<small>{channel.body}</small>
						</span>
					</a>
				))}
			</div>
		</section>
	</div>
</Base>
