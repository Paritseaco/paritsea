---
import Base from "../layouts/Base.astro";
import { getAuthorProfile } from "../utils/author-profile";
import { getAstroLocale, localizedPath } from "../utils/i18n";

const locale = getAstroLocale(Astro);
const author = getAuthorProfile(locale);

const copy = locale === "th"
	? {
		title: "เกี่ยวกับ Paritsea และ ปาริศ ฤทธิ์ชัย",
		description: "ทำความรู้จัก Paritsea พื้นที่รวมแนวคิดของ ปาริศ ฤทธิ์ชัย ที่ช่วยให้มองปัญหาให้ลึกขึ้นก่อนเลือกวิธีแก้",
		eyebrow: "รู้จัก Paritsea และผู้ก่อตั้ง",
		headline: "พื้นที่สำหรับคนที่อยากเข้าใจปัญหา ก่อนรีบเลือกวิธีแก้",
		intro: "Paritsea คือพื้นที่ที่ฉันใช้แบ่งปันบทความ วิธีมอง และงานที่จัดเป็นระบบแล้ว เพื่อให้คนอื่นอ่าน ศึกษา และนำไปปรับใช้กับบริบทของตัวเองได้",
		primaryAction: "เริ่มอ่านแนวคิด",
		secondaryAction: "รู้จักฉันให้มากขึ้น",
		portraitCaption: "ปาริศ ฤทธิ์ชัย · ผู้ก่อตั้ง Paritsea · ผู้พัฒนาแนวคิดและ Framework",
		originEyebrow: "จุดเริ่มต้น",
		originTitle: "Paritsea เริ่มจากคำถามว่า ทำไมบางปัญหาถึงแก้แล้วกลับมาอีก",
		originBody: [
			"ฉันมักพบว่าปัญหาที่ดูเหมือนเกิดจากคน เครื่องมือ หรือการสื่อสาร อาจมีสาเหตุอยู่ลึกกว่านั้น เช่น วิธีตั้งโจทย์ อำนาจตัดสินใจ แรงจูงใจ หรือโครงสร้างที่ทำให้พฤติกรรมเดิมเกิดซ้ำ",
			"Paritsea จึงไม่ได้เริ่มจากความต้องการสร้างคำตอบให้ครบทุกเรื่อง แต่เริ่มจากการเก็บคำถามและข้อสังเกตที่มีประโยชน์ แล้วค่อยเรียบเรียงให้ชัดพอที่คนอื่นจะอ่าน ตรวจสอบ และลองนำไปใช้ได้",
		],
		authorEyebrow: "คนที่อยู่เบื้องหลัง",
		authorTitle: "ฉันชื่อ ปาริศ ฤทธิ์ชัย",
		authorBody: [
			author.bio,
			"งานของฉันเชื่อมเรื่องคน งาน ธุรกิจ และระบบเข้าด้วยกัน เพราะหลายปัญหาไม่ได้อยู่ในหมวดใดหมวดหนึ่ง ฉันใช้ทั้งบทความ วิดีโอ และ Framework เพื่อแยกอาการออกจากต้นเหตุ แล้วอธิบายสิ่งที่เห็นในรูปแบบที่ช่วยให้ตัดสินใจได้ดีขึ้น",
			"ฉันไม่ได้คิดว่าทุกแนวคิดต้องกลายเป็น Framework บางเรื่องเหมาะจะอยู่เป็นบทความหรือคำถามเปิด ส่วนงานที่มีรูปแบบชัดและถูกนำไปใช้ซ้ำได้จึงค่อยพัฒนาเป็น Framework, Protocol หรือ Standard",
		],
		findEyebrow: "มีอะไรให้อ่าน",
		findTitle: "เลือกเริ่มจากสิ่งที่คุณต้องการ",
		formats: [
			{ label: "Journal", title: "มุมมองและคำถามที่ช่วยให้เห็นปัญหาต่างออกไป", body: "เหมาะสำหรับเริ่มอ่าน ทำความเข้าใจที่มาของความคิด และนำคำถามกลับไปมองสถานการณ์ของตัวเอง", href: "/journal", action: "อ่าน Journal" },
			{ label: "Framework · Protocol · Standard", title: "งานที่จัดโครงสร้างแล้วและนำไปใช้ได้ชัดขึ้น", body: "เหมาะเมื่อคุณต้องการกรอบคิด วิธีทำงาน หรือเกณฑ์ที่มีขอบเขตและฉบับอ้างอิงชัดเจน", href: "/system", action: "ดูงานที่จัดเป็นระบบ" },
			{ label: "Use & permission", title: "วิธีอ้างอิง ดัดแปลง และใช้ในเชิงพาณิชย์", body: "อธิบายว่าอะไรอ่านและนำไปศึกษาได้ อะไรต้องให้เครดิต และเมื่อใดควรติดต่อเพื่อขออนุญาต", href: "/ip/licensing", action: "ดูวิธีใช้และสิทธิ์" },
		],
		channelsEyebrow: "แต่ละพื้นที่มีหน้าที่ต่างกัน",
		channelsTitle: "ไม่จำเป็นต้องใส่ทุกอย่างไว้ในเว็บไซต์เดียว",
		channels: [
			{ label: "Paritsea", title: "อ่าน ศึกษา และกลับมาอ้างอิง", body: "เก็บบทความ แนวคิด และงานที่จัดเป็นระบบแล้วในรูปแบบที่อ่านซ้ำและตรวจสอบที่มาได้", href: localizedPath("/journal", locale), external: false },
			{ label: "YouTube", title: "ฟังเบื้องหลังและกระบวนการคิด", body: "ใช้เล่าเรื่อง ตัวอย่าง และความคิดที่ยังเหมาะกับการพูดคุยมากกว่าการทำเป็นเอกสาร", href: "https://www.youtube.com/@paritsea", external: true },
			{ label: "SE Ocean", title: "ดูแนวคิดที่ถูกแปลงเป็นบริการ", body: "แนวคิดบางส่วนจาก Paritsea ถูกพัฒนาเป็นบริการที่ใช้ได้จริงบน SE Ocean ซึ่งอาจครอบคลุมหลายเรื่องตามปัญหาและบริบท", href: "https://seocean.co.th", external: true },
		],
		useEyebrow: "เมื่อต้องการนำไปใช้ต่อ",
		useTitle: "อ่านและศึกษาได้ก่อน ส่วนการใช้สร้างมูลค่าค่อยดูเงื่อนไข",
		useBody: "Paritsea ตั้งใจให้งานเดินทางไปได้ไกลกว่าตัวผู้เขียน คุณสามารถอ่าน แบ่งปันลิงก์ และอ้างอิงโดยให้เครดิตได้ตามเงื่อนไขของงาน หากจะนำไปเป็นส่วนหนึ่งของสินค้า บริการ งานลูกค้า การอบรม หรือระบบที่สร้างรายได้ ควรตรวจเงื่อนไขและติดต่อขออนุญาตก่อน",
		useAction: "อ่านวิธีใช้และขออนุญาต",
	}
	: {
		title: "About Paritsea and Parit Ritchai",
		description: "Meet Paritsea and Parit Ritchai, and understand how observations become ideas for seeing problems more clearly before choosing a solution.",
		eyebrow: "Meet Paritsea and its founder",
		headline: "A place for understanding a problem before rushing to solve it",
		intro: "Paritsea is where I share essays, ways of seeing, and structured work that other people can read, study, and adapt to their own context.",
		primaryAction: "Start with the ideas",
		secondaryAction: "Get to know me",
		portraitCaption: "Parit Ritchai · Founder of Paritsea · Creator of ideas and frameworks",
		originEyebrow: "Where it began",
		originTitle: "Paritsea began with a question: why do some problems return after we solve them?",
		originBody: [
			"Problems that appear to come from people, tools, or communication often begin somewhere deeper: the way a question is framed, who can decide, what the system rewards, or which structure keeps producing the same behaviour.",
			"Paritsea does not exist to manufacture an answer for every subject. It begins by preserving useful questions and observations, then develops them until other people can read, examine, and try them in practice.",
		],
		authorEyebrow: "Behind the work",
		authorTitle: "I'm Parit Ritchai",
		authorBody: [
			author.bio,
			"My work connects people, work, business, and systems because many problems do not stay inside one category. I use essays, videos, and frameworks to separate symptoms from causes and express what I see in forms that make the next decision clearer.",
			"Not every idea needs to become a Framework. Some are better kept as essays or open questions. Work becomes a Framework, Protocol, or Standard only when a more explicit and reusable structure is useful.",
		],
		findEyebrow: "What you can read",
		findTitle: "Start with what you need",
		formats: [
			{ label: "Journal", title: "Perspectives and questions for seeing a problem differently", body: "A place to begin, understand where an idea came from, and take a useful question back to your own situation.", href: "/journal", action: "Read Journal" },
			{ label: "Framework · Protocol · Standard", title: "Structured work with a clearer path to application", body: "Use these when you need a lens, working method, or threshold with an explicit scope and reference version.", href: "/system", action: "Browse structured work" },
			{ label: "Use & permission", title: "How to cite, adapt, and use the work commercially", body: "See what can be read and studied, how attribution works, and when commercial use needs permission.", href: "/ip/licensing", action: "Review use and permission" },
		],
		channelsEyebrow: "Each space has a different job",
		channelsTitle: "Not everything needs to live on one website",
		channels: [
			{ label: "Paritsea", title: "Read, study, and return to the source", body: "Essays, ideas, and structured work stay here in forms that can be revisited and traced.", href: localizedPath("/journal", locale), external: false },
			{ label: "YouTube", title: "Hear the background and thinking process", body: "Stories, examples, and unfinished thinking that work better as a conversation than a formal document.", href: "https://www.youtube.com/@paritsea", external: true },
			{ label: "SE Ocean", title: "See ideas translated into services", body: "Selected ideas from Paritsea are developed into usable services at SE Ocean across different kinds of problems and contexts.", href: "https://seocean.co.th", external: true },
		],
		useEyebrow: "When you want to use the work",
		useTitle: "Read and study first; check the terms when the work creates value",
		useBody: "Paritsea is designed to let the work travel beyond the author. You may read, share links, and cite the work with attribution under its terms. If it becomes part of a product, service, client engagement, training, or revenue-generating system, review the terms and ask for permission first.",
		useAction: "Read use and permission",
	};
---

<Base title={copy.title} description={copy.description} locale={locale}>
	<article class="about-page">
		<header class="about-hero">
			<div class="about-hero-copy">
				<p class="about-eyebrow">{copy.eyebrow}</p>
				<h1>{copy.headline}</h1>
				<p class="about-intro">{copy.intro}</p>
				<div class="about-actions">
					<a class="about-button" href={localizedPath("/journal", locale)}>{copy.primaryAction}</a>
					<a class="about-text-link" href="#about-author">{copy.secondaryAction} <span aria-hidden="true">↓</span></a>
				</div>
			</div>
			<figure class="about-portrait">
				<img src={author.image} alt={author.imageAlt} width="1440" height="1800" />
				<figcaption>{copy.portraitCaption}</figcaption>
			</figure>
		</header>

		<section class="about-story about-section" aria-labelledby="about-origin-title">
			<div class="about-section-heading">
				<p class="about-eyebrow">{copy.originEyebrow}</p>
				<h2 id="about-origin-title">{copy.originTitle}</h2>
			</div>
			<div class="about-prose">
				{copy.originBody.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		<section id="about-author" class="about-author about-section" aria-labelledby="about-author-title">
			<div class="about-section-heading">
				<p class="about-eyebrow">{copy.authorEyebrow}</p>
				<h2 id="about-author-title">{copy.authorTitle}</h2>
			</div>
			<div class="about-prose about-author-prose">
				{copy.authorBody.map((paragraph) => <p>{paragraph}</p>)}
				<a class="about-text-link" href={localizedPath("/author/parit-ritchai", locale)}>
					{locale === "th" ? "ดูงานทั้งหมดของฉัน" : "Browse my published work"} <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<section class="about-section" aria-labelledby="about-formats-title">
			<div class="about-section-heading about-section-heading--stacked">
				<p class="about-eyebrow">{copy.findEyebrow}</p>
				<h2 id="about-formats-title">{copy.findTitle}</h2>
			</div>
			<div class="about-formats">
				{copy.formats.map((format) => (
					<a class="about-format" href={localizedPath(format.href, locale)}>
						<span>{format.label}</span>
						<h3>{format.title}</h3>
						<p>{format.body}</p>
						<strong>{format.action} <span aria-hidden="true">→</span></strong>
					</a>
				))}
			</div>
		</section>

		<section class="about-section about-channel-section" aria-labelledby="about-channels-title">
			<div class="about-section-heading">
				<div>
					<p class="about-eyebrow">{copy.channelsEyebrow}</p>
					<h2 id="about-channels-title">{copy.channelsTitle}</h2>
				</div>
				<p>{locale === "th" ? "Paritsea เป็นพื้นที่ของงานที่อ่านและอ้างอิงได้ ส่วนช่องทางอื่นช่วยเล่าเบื้องหลังหรือเปลี่ยนแนวคิดให้เป็นสิ่งที่นำไปใช้ได้" : "Paritsea keeps the work readable and referenceable. Other channels explain the thinking or translate selected ideas into something people can use."}</p>
			</div>
			<div class="about-channels">
				{copy.channels.map((channel) => (
					<a class="about-channel" href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noreferrer" : undefined}>
						<span>{channel.label}</span>
						<strong>{channel.title}</strong>
						<small>{channel.body}</small>
						<i aria-hidden="true">{channel.external ? "↗" : "→"}</i>
					</a>
				))}
			</div>
		</section>

		<section class="about-use" aria-labelledby="about-use-title">
			<div>
				<p class="about-eyebrow">{copy.useEyebrow}</p>
				<h2 id="about-use-title">{copy.useTitle}</h2>
			</div>
			<div>
				<p>{copy.useBody}</p>
				<a class="about-text-link" href={localizedPath("/ip/licensing", locale)}>{copy.useAction} <span aria-hidden="true">→</span></a>
			</div>
		</section>
	</article>
</Base>

<style>
	.about-page {
		width: min(1240px, calc(100vw - var(--page-gutter)));
		margin: 0 auto;
		padding: clamp(var(--spacing-8), 4vw, var(--spacing-14)) 0 var(--spacing-20);
	}

	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
		gap: clamp(var(--spacing-10), 7vw, var(--spacing-20));
		align-items: center;
		min-height: min(680px, calc(100svh - var(--nav-height)));
		padding-bottom: clamp(var(--spacing-14), 6vw, var(--spacing-20));
	}

	.about-hero-copy { max-width: 760px; }

	.about-eyebrow {
		margin: 0 0 var(--spacing-4);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1.55;
		color: var(--color-accent);
	}

	.about-hero h1,
	.about-section-heading h2,
	.about-use h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		letter-spacing: var(--tracking-tight);
		text-wrap: balance;
	}

	.about-hero h1 {
		max-width: 15ch;
		font-size: clamp(3rem, 5vw, 5.1rem);
		line-height: 1.02;
	}

	.about-intro {
		max-width: 660px;
		margin: var(--spacing-6) 0 0;
		font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
		line-height: 1.8;
		color: var(--color-text-secondary);
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-4) var(--spacing-6);
		margin-top: var(--spacing-7);
	}

	.about-button,
	.about-text-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.about-button {
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-accent);
		border: 1px solid var(--color-accent);
		color: var(--color-on-accent);
	}

	.about-text-link {
		gap: var(--spacing-2);
		color: var(--color-text);
		text-decoration-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
		text-underline-offset: .3em;
	}

	.about-button:hover,
	.about-text-link:hover { color: var(--color-accent); opacity: 1; }
	.about-button:hover { color: var(--color-on-accent); background: var(--color-accent-hover); }

	.about-portrait {
		width: 100%;
		max-width: 360px;
		margin: 0;
		justify-self: end;
	}

	.about-portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 27%;
		border: 1px solid var(--color-border-subtle);
	}

	.about-portrait figcaption {
		margin-top: var(--spacing-3);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: 1.55;
		color: var(--color-muted);
	}

	.about-section {
		padding: clamp(var(--spacing-14), 7vw, var(--spacing-24)) 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.about-story,
	.about-author,
	.about-use {
		display: grid;
		grid-template-columns: minmax(260px, .75fr) minmax(0, 1.25fr);
		gap: clamp(var(--spacing-8), 6vw, var(--spacing-20));
		align-items: start;
	}

	.about-section-heading { display: block; }
	.about-section-heading--stacked { margin-bottom: var(--spacing-10); }

	.about-section-heading h2,
	.about-use h2 {
		max-width: 19ch;
		font-size: clamp(2rem, 3.2vw, 3.5rem);
		line-height: 1.08;
	}

	.about-prose {
		max-width: 700px;
		font-size: 1.0625rem;
		line-height: 1.9;
		color: var(--color-text-secondary);
	}

	.about-prose p + p { margin-top: var(--spacing-5); }
	.about-prose .about-text-link { margin-top: var(--spacing-6); }

	.about-author {
		margin-inline: calc(-1 * clamp(var(--spacing-5), 4vw, var(--spacing-10)));
		padding-inline: clamp(var(--spacing-5), 4vw, var(--spacing-10));
		background: color-mix(in srgb, var(--color-bg-subtle) 62%, var(--color-bg));
	}

	.about-author-prose > p:first-child {
		font-size: clamp(1.25rem, 1.8vw, 1.55rem);
		line-height: 1.75;
		color: var(--color-text);
	}

	.about-formats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.about-format {
		display: flex;
		flex-direction: column;
		min-height: 390px;
		padding: var(--spacing-7);
		border-right: 1px solid var(--color-border-subtle);
		color: inherit;
	}

	.about-format:last-child { border-right: 0; }
	.about-format:hover { background: color-mix(in srgb, var(--color-bg-subtle) 56%, transparent); opacity: 1; }

	.about-format > span,
	.about-channel > span {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: 1.55;
		color: var(--color-accent);
	}

	.about-format h3 {
		margin: var(--spacing-8) 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.55rem, 2vw, 2rem);
		font-weight: 500;
		line-height: 1.25;
	}

	.about-format p {
		margin: var(--spacing-4) 0 var(--spacing-8);
