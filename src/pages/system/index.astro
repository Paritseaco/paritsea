---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import IntellectualField from "../../components/IntellectualField.astro";
import { getAstroLocale, localizedPath } from "../../utils/i18n";

const locale = getAstroLocale(Astro);
const { entries, cacheHint } = await getEmDashCollection("posts");
Astro.cache.set(cacheHint);

const count = (type: string) => entries.filter((entry) => entry.data.content_type === type).length;
const layers = locale === "th"
	? [
		{ number: "01", state: "วิธีคิด", name: "Framework", count: count("framework"), href: "/system/frameworks", description: "ช่วยจัดวิธีมองและหลักการให้เห็นความสัมพันธ์ของปัญหาอย่างเป็นระบบ" },
		{ number: "02", state: "วิธีนำไปใช้", name: "Protocol", count: count("protocol"), href: "/system/protocols", description: "บอกว่าสิ่งใดควรถูกทำหรือรับผิดชอบ เมื่อต้องนำ Framework ไปใช้จริง" },
		{ number: "03", state: "เกณฑ์ตรวจสอบ", name: "Standard", count: count("standard"), href: "/system/standards", description: "บอกว่าควรดูคำถามหรือหลักฐานใด เพื่อตรวจว่าสิ่งที่กำหนดไว้เกิดขึ้นจริงหรือไม่" },
	]
	: [
		{ number: "01", state: "Structured", name: "Frameworks", count: count("framework"), href: "/system/frameworks", description: "Structures that organise concepts, principles, and constraints into a coherent reference." },
		{ number: "02", state: "Operable", name: "Protocols", count: count("protocol"), href: "/system/protocols", description: "Obligations or methods derived from a Framework while preserving the meaning of the source." },
		{ number: "03", state: "Verifiable", name: "Standards", count: count("standard"), href: "/system/standards", description: "Conditions used to examine whether a Protocol obligation is present within its stated scope." },
	];

const copy = locale === "th" ? {
	title: "งานอ้างอิง — Paritsea",
	role: "ศูนย์รวมงานที่จัดระบบแล้ว",
	headline: "เลือกงานให้ตรงกับสิ่งที่ต้องการ: วิธีคิด วิธีนำไปใช้ หรือเกณฑ์ตรวจสอบ",
	summary: "Framework ช่วยจัดวิธีมอง Protocol บอกสิ่งที่ควรทำ และ Standard ให้เกณฑ์สำหรับตรวจสอบ ทุกฉบับระบุที่มา สถานะ และขอบเขตการใช้ไว้ชัดเจน",
	choose: "งานแต่ละประเภทช่วยต่างกัน",
	chooseNote: "เลือกจากสิ่งที่ต้องการใช้ ไม่จำเป็นต้องอ่านตามลำดับ",
	path: "เลือกเอกสารให้ถูกประเภท",
	pathTitle: "ไม่ต้องอ่านตามลำดับ และไม่ใช่ทุกแนวคิดต้องมีครบทั้งสามแบบ",
	pathBody: "หากต้องการทำความเข้าใจปัญหา ให้เริ่มจาก Framework หากต้องการแนวทางนำไปใช้ ให้ดู Protocol และหากต้องการตรวจว่าสิ่งที่กำหนดไว้เกิดขึ้นจริงหรือไม่ ให้ดู Standard",
	boundary: "ขอบเขต",
	boundaryTitle: "งานที่อ่านได้ที่นี่ไม่ใช่บริการที่ปรึกษา",
	boundaryBody: "Paritsea เผยแพร่แนวคิดและเอกสารต้นทาง ส่วนการนำไปใช้ในองค์กรต้องปรับให้เหมาะกับบริบท และไม่สามารถเปลี่ยนความหมายของต้นฉบับได้เอง",
	useLink: "ตรวจวิธีใช้และอ้างอิง",
} : {
	title: "Reference work — Paritsea",
	role: "Hub for structured work",
	headline: "When an observation must carry more responsibility than observation alone",
	summary: "This hub holds Frameworks, Protocols, and Standards with explicit status, version, provenance, and scope. They are read to cite, examine, or apply under the conditions of each record.",
	choose: "Choose by the role of the work",
	chooseNote: "The three types are not ascending levels of value. They answer different questions.",
	path: "How work develops",
	pathTitle: "The path is a map, not a production line",
	pathBody: "A Journal entry may remain a Journal entry. A pattern may become a Concept without becoming a Framework. A Standard only emerges when something genuinely needs to be examined. Formalising adds responsibility; it does not declare the work more important.",
	boundary: "Boundary",
	boundaryTitle: "Reference work is not a service",
	boundaryBody: "Paritsea keeps the source record and its history of change. Organizational application belongs to the interpreter's context and does not automatically revise the canonical record.",
	useLink: "Review use and citation",
};

const fieldQuestions = locale === "th"
	? [
		{ title: "ต้องการเข้าใจปัญหาจากมุมไหน", meta: "เริ่มจาก Framework" },
		{ title: "ต้องทำหรือรับผิดชอบอะไรบ้าง", meta: "ดู Protocol" },
		{ title: "จะรู้ได้อย่างไรว่าทำจริงแล้ว", meta: "ตรวจด้วย Standard" },
	]
	: [
		{ title: "What is this idea helping us see?", meta: "Before choosing a document type" },
		{ title: "When should a proposition become an obligation?", meta: "Framework → Protocol" },
		{ title: "What should be tested, and what should remain contextual?", meta: "Protocol → Standard" },
	];

const fieldCounts = {
	journal: count("journal"),
	concept: count("concept"),
	framework: count("framework"),
	protocol: count("protocol"),
	standard: count("standard"),
};
---

<Base title={copy.title} description={copy.summary} locale={locale}>
	<main class="experience-page system-page">
		<Breadcrumb crumbs={[{ label: locale === "th" ? "หน้าแรก" : "Home", href: localizedPath("/", locale) }, { label: locale === "th" ? "งานอ้างอิง" : "Reference work" }]} />
		<header class="system-intro">
			<p class="experience-label" data-state="governed">{copy.role}</p>
			<h1 class="experience-title">{copy.headline}</h1>
			<p class="experience-summary">{copy.summary}</p>
		</header>

		<section class="experience-section" aria-labelledby="layers-title">
			<div class="experience-section-heading">
				<h2 id="layers-title">{copy.choose}</h2>
				<p>{copy.chooseNote}</p>
			</div>
			<div class="experience-index">
				{layers.map((layer) => (
					<a class="experience-index-row" href={localizedPath(layer.href, locale)}>
						<span class="experience-index-meta">{layer.number} · {layer.state}</span>
						<div class="experience-index-copy">
							<h3>{layer.name}</h3>
							<p>{layer.description}</p>
						</div>
						<span class="experience-index-state">{String(layer.count).padStart(2, "0")} {locale === "th" ? "งาน" : "works"} →</span>
					</a>
				))}
			</div>
		</section>

		<section class="experience-section system-field" aria-labelledby="system-field-title">
			<div class="system-field-intro">
				<p class="experience-label" data-state="moving">{copy.path}</p>
				<h2 id="system-field-title">{copy.pathTitle}</h2>
				<p>{copy.pathBody}</p>
			</div>
			<IntellectualField locale={locale} questions={fieldQuestions} counts={fieldCounts} compact />
		</section>

		<section class="experience-section">
			<div class="experience-note">
				<div><p class="experience-label" data-state="governed">{copy.boundary}</p><h2>{copy.boundaryTitle}</h2></div>
				<div><p>{copy.boundaryBody}</p><a class="experience-link" href={localizedPath("/ip", locale)}>{copy.useLink} <span aria-hidden="true">→</span></a></div>
			</div>
		</section>
	</main>
</Base>

<style>
	.system-intro { max-width: 1080px; padding: var(--spacing-8) 0 var(--spacing-10); border-bottom: 1px solid var(--color-border); }
	.system-field-intro { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1fr); gap: var(--spacing-8); align-items: end; margin-bottom: var(--spacing-8); }
	.system-field-intro h2 { max-width: 18ch; font-size: clamp(1.9rem, 3vw, 3.25rem); line-height: 1.15; }
	.system-field-intro > p:last-child { max-width: 60ch; color: var(--color-text-secondary); line-height: 1.75; }
	:global(:lang(th)) .system-field-intro h2 { font-family: var(--font-sans); font-weight: 300; font-style: normal; letter-spacing: 0; line-height: 1.5; }
	:global(:lang(th)) .system-field-intro > p:last-child { font-size: 1.0625rem; line-height: 1.9; letter-spacing: 0; word-break: keep-all; }
	@media (max-width: 800px) { .system-field-intro { grid-template-columns: 1fr; } }
</style>
