---
import { getEmDashCollection } from "emdash";
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import {
	getAstroLocale,
	localizeEntry,
	localizedEntryPath,
	localizedPath,
	mergeLocalizedEntries,
} from "../../../utils/i18n";
import { localizeRecordValue } from "../../../utils/intellectual-localization";
import { publicEntrySlug } from "../../../utils/public-paths";

const locale = getAstroLocale(Astro);
const englishResult = await getEmDashCollection("posts", { locale: "en" });
const localeResult = locale === "th"
	? await getEmDashCollection("posts", { locale: "th" })
	: englishResult;
const entries = mergeLocalizedEntries(englishResult.entries, localeResult.entries, locale);
const cacheHint = localeResult.cacheHint;
Astro.cache.set(cacheHint);
const works = entries
	.filter((entry) =>
		entry.data.content_type === "framework" ||
		(entry.data.framework_page === "the-doctrine" && publicEntrySlug(entry) === "doctrine")
	)
	.map((entry) => localizeEntry(entry, "posts", locale));
const copy = locale === "th" ? {
	title: "Framework — Paritsea", role: "วิธีคิดที่จัดเป็นระบบแล้ว", headline: "Framework ช่วยให้เห็นว่าส่วนต่าง ๆ ของปัญหาเกี่ยวข้องกันอย่างไร", summary: "Framework จัดหลักคิด ความสัมพันธ์ และข้อจำกัดให้อยู่ในโครงเดียวกัน เพื่อให้คนอื่นนำไปอ้างอิงหรือใช้วิเคราะห์ปัญหาได้ แต่ไม่ใช่คำตอบสำเร็จรูปที่ใช้ได้เหมือนกันทุกสถานการณ์", count: "Framework ที่เผยแพร่", open: "เปิดเอกสารฉบับเต็ม",
} : {
	title: "Frameworks — Paritsea", role: "Framework hub", headline: "Structures that make related ideas accountable to one another", summary: "A Framework organises concepts, principles, and constraints into a citable system. It is not a universal answer. Every record must state its scope, version, provenance, and what it does not establish.", count: "published Frameworks", open: "Open full document",
};
---
<Base title={copy.title} description={copy.summary} locale={locale}>
	<main class="experience-page framework-hub">
		<Breadcrumb crumbs={[{ label: locale === "th" ? "งานอ้างอิง" : "Reference work", href: localizedPath("/system", locale) }, { label: "Framework" }]} />
		<header><div><p class="experience-label" data-state="governed">{copy.role}</p><h1 class="experience-title">{copy.headline}</h1><p class="experience-summary">{copy.summary}</p></div><dl><dt>{copy.count}</dt><dd>{String(works.length).padStart(2, "0")}</dd></dl></header>
		<section class="experience-index">
			{works.map((work, index) => <a class="experience-index-row" href={localizedEntryPath(`/system/frameworks/${publicEntrySlug(work) === "doctrine" ? "paritsea-framework" : publicEntrySlug(work)}`, work, locale)}><span class="experience-index-meta">{String(index + 1).padStart(2, "0")} · Framework</span><div class="experience-index-copy"><h3>{work.data.title}</h3>{work.data.excerpt && <p>{work.data.excerpt}</p>}</div><span class="experience-index-state">v{publicEntrySlug(work) === "doctrine" ? "1.1" : work.data.document_version ?? "1.0"} · {localizeRecordValue(locale, work.data.lifecycle_status ?? "current")}<br />{copy.open} →</span></a>)}
		</section>
	</main>
</Base>
<style>
	.framework-hub header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--spacing-12); align-items: end; padding: var(--spacing-12) 0 var(--spacing-16); border-bottom: 1px solid var(--color-border); }
	.framework-hub dl { min-width: 170px; padding-left: var(--spacing-6); border-left: 1px solid var(--color-border); }
	.framework-hub dt { font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-muted); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
	.framework-hub dd { margin-top: var(--spacing-2); font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 3.75rem); line-height: 1; color: var(--color-accent); }
	:global(:lang(th)) .framework-hub dt { font-family: var(--font-sans); font-size: .875rem; text-transform: none; letter-spacing: 0; }
	:global(:lang(th)) .framework-hub dd { font-family: var(--font-sans); font-weight: 300; }
	@media (max-width: 700px) { .framework-hub header { grid-template-columns: 1fr; } .framework-hub dl { padding: var(--spacing-5) 0 0; border: 0; border-top: 1px solid var(--color-border-subtle); } }
</style>
