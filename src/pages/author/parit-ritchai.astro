---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageRoleHeader from "../../components/PageRoleHeader.astro";
import {
	getAstroLocale,
	localizeEntry,
	localizedEntryPath,
	localizedPath,
	mergeLocalizedEntries,
} from "../../utils/i18n";
import {
	publicEntrySlug,
	resolveIntellectualWorkPath,
} from "../../utils/public-paths";
import { localizeWorkFamily } from "../../utils/intellectual-localization";
import { getAuthorProfile } from "../../utils/author-profile";

const locale = getAstroLocale(Astro);
const author = getAuthorProfile(locale);
const englishResult = await getEmDashCollection("posts", {
	locale: "en",
	orderBy: { published_at: "desc" },
});
const localeResult = locale === "th"
	? await getEmDashCollection("posts", {
			locale: "th",
			orderBy: { published_at: "desc" },
		})
	: englishResult;
const entries = mergeLocalizedEntries(englishResult.entries, localeResult.entries, locale);
Astro.cache.set(localeResult.cacheHint);
const works = entries.map((entry) => localizeEntry(entry, "posts", locale));
const workPath = (work: (typeof works)[number]) =>
	resolveIntellectualWorkPath(
		publicEntrySlug(work),
		work.data.content_type,
		work.data.framework_page,
	) ?? `/journal/${publicEntrySlug(work)}`;
const workFamily = (work: (typeof works)[number]) =>
	localizeWorkFamily(locale, work.data.content_type || work.data.framework_page);
const intro = locale === "th"
	? `${author.bio} หน้านี้รวมงานที่เผยแพร่ภายใต้ชื่อของฉัน เพื่อให้เลือกอ่านต่อได้จากที่เดียว`
	: `${author.bio} This page brings together the work published under my name so readers can continue from one place.`;
---

<Base title={locale === "th" ? "ปาริศ ฤทธิ์ชัย — ระเบียนผู้เขียน" : "Parit Ritchai — Author record"} description={intro} locale={locale}>
	<div class="author-shell">
		<Breadcrumb crumbs={[{ label: locale === "th" ? "วิธีมอง" : "Lens", href: localizedPath("/about", locale) }, { label: locale === "th" ? "ปาริศ ฤทธิ์ชัย" : "Parit Ritchai" }]} />
		<PageRoleHeader role={locale === "th" ? "เกี่ยวกับผู้เขียน" : "About the author"} eyebrow={author.role} title={author.name} intro={intro} count={works.length} statusLabel={locale === "th" ? "งานที่เผยแพร่" : "Published work"} />
		<section class="author-boundary">
			<h2>{locale === "th" ? "ฉันเขียนเรื่องอะไร" : "What I write about"}</h2>
			<p>{locale === "th" ? "งานของฉันเชื่อมเรื่องคน งาน ธุรกิจ และระบบเข้าด้วยกัน โดยเริ่มจากคำถามว่าต้นเหตุจริงอยู่ตรงไหน ใครมีอำนาจเปลี่ยนมัน และวิธีคิดแบบใดช่วยให้ตัดสินใจได้ดีขึ้น" : "My work connects people, work, business, and systems. It begins by asking where the cause really sits, who can change it, and which way of seeing makes the next decision clearer."}</p>
		</section>
		<section class="bibliography" aria-labelledby="bibliography-title">
			<h2 id="bibliography-title">{locale === "th" ? "งานที่เผยแพร่" : "Published record"}</h2>
			{works.map((work) => <a href={localizedEntryPath(workPath(work), work, locale)}><span>{workFamily(work)}</span><strong>{work.data.title}</strong></a>)}
		</section>
	</div>
</Base>

<style>
	.author-shell { width: var(--wide-width); margin: 0 auto; padding: var(--spacing-8) 0 var(--spacing-20); }
	.author-boundary { display: grid; grid-template-columns: minmax(220px, .6fr) 1.4fr; gap: var(--spacing-12); padding: var(--spacing-16) 0; border-bottom: 1px solid var(--color-border); }
	.author-boundary h2 { font-size: var(--font-size-2xl); }
	.author-boundary p { max-width: 700px; font-family: var(--font-serif); font-size: var(--font-size-xl); line-height: 1.65; }
	.bibliography { padding-top: var(--spacing-12); }
	.bibliography > h2 { margin-bottom: var(--spacing-6); }
	.bibliography a { display: grid; grid-template-columns: 180px 1fr; gap: var(--spacing-6); padding: var(--spacing-5) 0; border-top: 1px solid var(--color-border-subtle); }
	.bibliography span { font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-muted); }
	.bibliography strong { font-family: var(--font-serif); font-size: var(--font-size-xl); font-weight: 500; }
	:global(:lang(th)) .author-boundary h2, :global(:lang(th)) .bibliography strong { font-family: var(--font-sans); font-weight: 300; line-height: 1.48; letter-spacing: 0; }
	:global(:lang(th)) .author-boundary p { font-family: var(--font-sans); font-size: 1.0625rem; line-height: 1.9; letter-spacing: 0; word-break: keep-all; }
	:global(:lang(th)) .bibliography span { font-family: var(--font-sans); font-size: var(--font-size-sm); letter-spacing: 0; }
	@media (max-width: 700px) { .author-boundary, .bibliography a { grid-template-columns: 1fr; gap: var(--spacing-3); } }
</style>
