---
interface Props {
	variant: "doctrine" | "protocols" | "standards" | "the-method" | "implementations";
	compact?: boolean;
	className?: string;
	locale?: "th" | "en";
}

const { variant, compact = false, className, locale = "th" } = Astro.props;

const contentByLocale = {
	en: {
	doctrine: {
		eyebrow: "Use and Reference",
		title: "The Framework is open for reference, citation, and non-commercial adaptation.",
		summary:
			"You may read, discuss, teach, and adapt this Framework with attribution. Commercial enforcement, certification claims, or official implementation status require separate permission.",
		points: [
			"Cite with attribution and link back to Paritsea.",
			"Adapt ideas for internal or personal use without claiming endorsement.",
			"Do not present reinterpretations as official Paritsea Framework.",
		],
	},
	protocols: {
		eyebrow: "Use and Reference",
		title: "Protocols can be studied and adapted, but not represented as official enforcement without permission.",
		summary:
			"Protocols are public structural instruments. They may be referenced and adapted with attribution, but commercial deployment, certification, or official Paritsea-branded enforcement requires agreement.",
		points: [
			"Use internally, academically, or analytically with attribution.",
			"Commercial deployment or certification requires permission.",
			"Adaptation does not equal official implementation.",
		],
	},
	standards: {
		eyebrow: "Use and Reference",
		title: "Standards may be cited and interpreted publicly, but not converted into unauthorised certification or scoring systems.",
		summary:
			"Standards define verifiable conditions. You may reference and adapt them with attribution, but not market your use as Paritsea-certified or official without permission.",
		points: [
			"Cite the standard and preserve its structural meaning.",
			"Do not turn it into ratings, badges, or certification claims without agreement.",
			"Commercial enforcement requires a separate licence.",
		],
	},
	"the-method": {
		eyebrow: "Use and Reference",
		title: "Journal is a public analytical registry intended for citation, discussion, and adaptation.",
		summary:
			"These entries may be referenced and built from with attribution. They are analytical objects, not official endorsements, and should not be repackaged as certified Paritsea positions.",
		points: [
			"Cite and discuss entries publicly with attribution.",
			"Use them as reference observations in your own work.",
			"Do not imply Paritsea approval of your adaptation or product.",
		],
	},
	implementations: {
		eyebrow: "Use and Reference",
		title: "Implementations demonstrate application, but only documented implementations carry official status.",
		summary:
			"You may study and learn from these implementations, but adopting similar ideas does not make another system an official Paritsea implementation or a certified enforcement surface.",
		points: [
			"Reference implementations as examples, not transferable endorsements.",
			"Only documented implementations are official Paritsea implementations.",
			"Commercial productisation of Paritsea logic still follows the licensing policy.",
		],
	},
	},
	th: {
		doctrine: {
			eyebrow: "การใช้และการอ้างอิง",
			title: "อ่าน อ้างอิง และนำ Framework ไปใช้ภายในได้เมื่อให้เครดิต",
			summary:
				"หากนำ Framework ไปเป็นส่วนหนึ่งของสินค้า บริการตรวจประเมิน หรือระบบที่สร้างรายได้ ต้องขออนุญาตก่อน",
			points: [
				"อ้างอิงพร้อมให้เครดิตและลิงก์กลับมายัง Paritsea",
				"ปรับแนวคิดเพื่อใช้ภายในหรือส่วนตัวได้ โดยไม่อ้างว่า Paritsea รับรอง",
				"อย่าเรียกงานที่ตีความใหม่ว่าเป็น Paritsea Framework ฉบับทางการ",
			],
		},
		protocols: {
			eyebrow: "การใช้และการอ้างอิง",
			title: "ศึกษาและปรับ Protocol ให้เข้ากับบริบทได้ แต่ต้องแยกจากฉบับต้นทางให้ชัด",
			summary:
				"อ้างอิงและปรับใช้ได้เมื่อให้เครดิต แต่หากนำไปขาย ใช้รับรอง หรือบังคับใช้ภายใต้ชื่อ Paritsea ต้องได้รับอนุญาต",
			points: [
				"ใช้ภายใน ใช้เชิงวิชาการ หรือใช้วิเคราะห์ได้เมื่อให้เครดิต",
				"การนำไปสร้างรายได้หรือใช้เป็นเกณฑ์รับรองต้องได้รับอนุญาต",
				"การปรับใช้เองไม่ได้ทำให้งานนั้นเป็นฉบับทางการของ Paritsea",
			],
		},
		standards: {
			eyebrow: "การใช้และการอ้างอิง",
			title: "อ้างอิง Standard ได้ แต่ห้ามนำไปขายเป็นคะแนนหรือตรารับรองโดยไม่ได้รับอนุญาต",
			summary:
				"Standard ระบุสิ่งที่ใช้ตรวจสอบได้ คุณนำไปศึกษาและปรับใช้ได้เมื่อให้เครดิต แต่ห้ามอ้างว่า Paritsea รับรองผลการประเมินนั้น",
			points: [
				"อ้างอิงชื่อ Standard ฉบับที่ใช้ และรักษาความหมายสำคัญไว้",
				"อย่าแปลงเป็นคะแนน ตราสัญลักษณ์ หรือคำรับรองโดยไม่มีข้อตกลง",
				"การใช้เป็นส่วนหนึ่งของบริการที่สร้างรายได้ต้องขออนุญาต",
			],
		},
		"the-method": {
			eyebrow: "การใช้และการอ้างอิง",
			title: "Journal รวมข้อสังเกตและคำถามที่ยังเปิดให้คิดต่อ",
			summary:
				"อ้างอิงและต่อยอดได้เมื่อให้เครดิต แต่ความคิดเห็นหรือผลงานที่คุณพัฒนาต่อไม่ใช่สิ่งที่ Paritsea รับรองโดยอัตโนมัติ",
			points: [
				"อ้างอิงและอภิปรายบันทึกต่อสาธารณะได้เมื่อให้เครดิต",
				"ใช้เป็นข้อสังเกตอ้างอิงในงานของตัวเองได้",
				"อย่าสื่อว่า Paritsea รับรองงานที่คุณดัดแปลงหรือผลิตภัณฑ์ของคุณ",
			],
		},
		implementations: {
			eyebrow: "การใช้และการอ้างอิง",
			title: "ศึกษาตัวอย่างการนำไปใช้ได้ แต่สถานะของแต่ละกรณีไม่โอนไปยังงานอื่น",
			summary:
				"การใช้แนวคิดคล้ายกันไม่ได้ทำให้งานของคุณกลายเป็นการใช้อย่างเป็นทางการ หรือเป็นระบบที่ Paritsea รับรอง",
			points: [
				"อ้างถึงเป็นตัวอย่างได้ แต่ไม่ใช่คำรับรองที่นำไปใช้กับงานอื่นได้",
				"เฉพาะรายการที่บันทึกไว้เท่านั้นที่มีสถานะตามที่ระบุ",
				"การนำตรรกะ Paritsea ไปทำเป็นผลิตภัณฑ์เชิงพาณิชย์ยังต้องอยู่ภายใต้นโยบายสิทธิการใช้",
			],
		},
	},
} as const;

const content = contentByLocale[locale][variant];
const licensingHref = locale === "th" ? "/th/ip/licensing" : "/ip/licensing";
const linkLabel = locale === "en" ? "Read the full licence and use policy →" : "อ่านนโยบายสิทธิการใช้ฉบับเต็ม →";
---

<aside class:list={["usage-guidance", compact && "usage-guidance--compact", className]}>
	<p class="usage-guidance-eyebrow">{content.eyebrow}</p>
	<h2 class="usage-guidance-title">{content.title}</h2>
	<p class="usage-guidance-summary">{content.summary}</p>
	<ul class="usage-guidance-list">
		{content.points.map((point) => (
			<li>{point}</li>
		))}
	</ul>
	<p class="usage-guidance-link-row">
		<a href={licensingHref} class="usage-guidance-link">{linkLabel}</a>
	</p>
</aside>

<style>
	/*
	 * Editorial annotation style — left-border only, no fill.
	 * Reads as a document margin note, not a UI card.
	 */
	.usage-guidance {
		margin: var(--spacing-10) 0 0;
		padding: var(--spacing-4) 0 var(--spacing-4) var(--spacing-5);
		border: none;
		border-left: 2px solid var(--color-border-subtle);
		background: transparent;
	}

	.usage-guidance--compact {
		margin: var(--spacing-8) 0 0;
	}

	.usage-guidance-eyebrow {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-widest);
		color: var(--color-muted);
		margin: 0 0 var(--spacing-2);
	}

	.usage-guidance-title {
		font-family: var(--font-sans);
		font-size: var(--font-size-base);
		font-weight: 500;
		line-height: 1.5;
		margin: 0 0 var(--spacing-3);
		letter-spacing: 0;
		color: var(--color-text);
	}

	.usage-guidance-summary {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-3);
	}

	.usage-guidance-list {
		margin: 0 0 var(--spacing-3);
		padding-left: 1rem;
	}

	.usage-guidance-list li {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
		margin-bottom: var(--spacing-1);
	}

	.usage-guidance-link-row {
		margin: 0;
	}

	.usage-guidance-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.usage-guidance-link:hover {
		color: var(--color-text);
	}

	@media (max-width: 720px) {
		.usage-guidance--compact {
			display: none;
		}
	}
</style>
