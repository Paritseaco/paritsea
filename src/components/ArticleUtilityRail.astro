---
import type { SiteLocale } from "../utils/i18n";
import { ui } from "../utils/i18n";

interface BylineCredit {
	byline: {
		displayName: string;
		avatarMediaId?: string | null;
	};
	roleLabel?: string | null;
}

interface Props {
	bylines?: BylineCredit[];
	lastUpdatedLabel?: string | null;
	lastUpdatedIso?: string | null;
	readingTime: number;
	postId: string;
	initialViews: number;
	pageUrl: string;
	pageTitle: string;
	locale?: SiteLocale;
}

const {
	bylines = [],
	lastUpdatedLabel = null,
	lastUpdatedIso = null,
	readingTime,
	postId,
	initialViews,
	pageUrl,
	pageTitle,
	locale = "th",
} = Astro.props;

const labels = ui[locale].labels;
const actionLabels = locale === "th"
	? {
			group: "แชร์หรือบันทึกบทความ",
			share: "แชร์",
			shareFallback: "คัดลอกลิงก์สำหรับแชร์แล้ว",
			save: "บันทึกไว้อ่าน",
			saved: "บันทึกแล้ว",
			saveFailed: "ไม่สามารถบันทึกบทความในเบราว์เซอร์นี้ได้",
		}
	: {
			group: "Share or save this article",
			share: "Share",
			shareFallback: "Share link copied.",
			save: "Save for later",
			saved: "Saved",
			saveFailed: "This browser could not save the article.",
		};
const localizeBylineName = (name: string) => locale === "th" && name === "Parit Ritchai" ? "ปาริศ ฤทธิ์ชัย" : name;
---

<div
	class="article-utility-rail"
	data-article-utility-rail
	data-page-url={pageUrl}
	data-page-title={pageTitle}
	data-copy-success={labels.copied}
	data-copy-failed={labels.copyFailed}
	data-share-fallback={actionLabels.shareFallback}
	data-save-label={actionLabels.save}
	data-saved-label={actionLabels.saved}
	data-save-failed={actionLabels.saveFailed}
>
	<div class="article-utility-actions" role="group" aria-label={actionLabels.group}>
		<button type="button" class="article-utility-action" data-share-url>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M12 16V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
			<span>{actionLabels.share}</span>
		</button>
		<button type="button" class="article-utility-action" data-save-article aria-pressed="false">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M6.5 4.5a2 2 0 012-2h7a2 2 0 012 2v17L12 18l-5.5 3.5v-17z"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
			<span data-save-text>{actionLabels.save}</span>
		</button>
		<button type="button" class="article-utility-action" data-copy-url>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M10.5 13.5L13.5 10.5M8.318 15.682l-1.06 1.06a3 3 0 01-4.243-4.242l4.95-4.95a3 3 0 014.243 0l1.06 1.06M15.682 8.318l1.06-1.06a3 3 0 114.243 4.242l-4.95 4.95a3 3 0 01-4.243 0l-1.06-1.06"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
			<span>{labels.copyUrl}</span>
		</button>
	</div>

	<p class="article-utility-status sr-only" aria-live="polite" data-utility-status></p>

	{
		bylines.length > 0 && (
			<div class="article-utility-block article-utility-block--byline">
				<span class="article-utility-label">
					{bylines.length === 1 ? labels.author : labels.authors}
				</span>
				<div class="article-utility-bylines">
					{bylines.map((credit) => (
						<div class="article-utility-byline">
							{credit.byline.avatarMediaId && (
								<img
									src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
									alt={localizeBylineName(credit.byline.displayName)}
									class="article-utility-avatar"
								/>
							)}
							<div class="article-utility-byline-info">
								<span class="article-utility-byline-name">{localizeBylineName(credit.byline.displayName)}</span>
								{credit.roleLabel && (
									<span class="article-utility-byline-role">{credit.roleLabel}</span>
								)}
							</div>
						</div>
					))}
				</div>
			</div>
		)
	}

	{
		lastUpdatedLabel && (
			<div class="article-utility-block">
				<span class="article-utility-label">{labels.lastUpdated}</span>
				<time class="article-utility-value" datetime={lastUpdatedIso ?? undefined}>
					{lastUpdatedLabel}
				</time>
			</div>
		)
	}

	<div class="article-utility-block">
		<span class="article-utility-label">{labels.readingTime}</span>
		<span class="article-utility-value">{readingTime} {labels.minRead}</span>
	</div>

	<div class="article-utility-block">
		<span class="article-utility-label">{labels.readership}</span>
		<span
			class="article-utility-value"
			id="article-readership"
			data-post-id={postId}
			data-initial-views={initialViews}
		>
			{initialViews} {labels.reads}
		</span>
	</div>
</div>

<script is:inline>
	const copyText = async (text) => {
		if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
		await navigator.clipboard.writeText(text);
	};

	document.querySelectorAll("[data-article-utility-rail]").forEach((rail) => {
		if (rail.dataset.jsBound === "true") return;
		rail.dataset.jsBound = "true";

		const status = rail.querySelector("[data-utility-status]");
		const shareButton = rail.querySelector("[data-share-url]");
		const saveButton = rail.querySelector("[data-save-article]");
		const saveText = rail.querySelector("[data-save-text]");
		const copyUrlButton = rail.querySelector("[data-copy-url]");
		const pageUrl = rail.dataset.pageUrl || window.location.href;
		const pageTitle = rail.dataset.pageTitle || document.title;
		const copySuccess = rail.dataset.copySuccess || "Page URL copied.";
		const copyFailed = rail.dataset.copyFailed || "Could not copy the page URL automatically.";
		const shareFallback = rail.dataset.shareFallback || copySuccess;
		const saveLabel = rail.dataset.saveLabel || "Save for later";
		const savedLabel = rail.dataset.savedLabel || "Saved";
		const saveFailed = rail.dataset.saveFailed || "Could not save this article.";
		const savedArticlesKey = "paritsea:saved-articles:v1";

		const readSavedArticles = () => {
			try {
				const parsed = JSON.parse(localStorage.getItem(savedArticlesKey) || "[]");
				return Array.isArray(parsed) ? parsed : [];
			} catch {
				return [];
			}
		};

		const updateSavedState = (isSaved) => {
			if (!(saveButton instanceof HTMLButtonElement)) return;
			saveButton.setAttribute("aria-pressed", isSaved ? "true" : "false");
			if (saveText) saveText.textContent = isSaved ? savedLabel : saveLabel;
		};

		updateSavedState(readSavedArticles().some((item) => item?.url === pageUrl));

		shareButton?.addEventListener("click", async () => {
			try {
				if (navigator.share) {
					await navigator.share({ title: pageTitle, url: pageUrl });
					return;
				}
				await copyText(pageUrl);
				if (status) status.textContent = shareFallback;
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") return;
				if (status) status.textContent = copyFailed;
			}
		});

		saveButton?.addEventListener("click", () => {
			try {
				const savedArticles = readSavedArticles();
				const existingIndex = savedArticles.findIndex((item) => item?.url === pageUrl);
				if (existingIndex >= 0) {
					savedArticles.splice(existingIndex, 1);
					localStorage.setItem(savedArticlesKey, JSON.stringify(savedArticles));
					updateSavedState(false);
				} else {
					savedArticles.unshift({ url: pageUrl, title: pageTitle, savedAt: new Date().toISOString() });
					localStorage.setItem(savedArticlesKey, JSON.stringify(savedArticles.slice(0, 100)));
					updateSavedState(true);
				}
			} catch {
				if (status) status.textContent = saveFailed;
			}
		});

		copyUrlButton?.addEventListener("click", async () => {
			try {
				await copyText(pageUrl);
				if (status) status.textContent = copySuccess;
			} catch {
				if (status) status.textContent = copyFailed;
			}
		});
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.article-utility-rail {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.article-utility-actions {
		display: grid;
		gap: 0;
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.article-utility-action {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		width: 100%;
		min-height: 44px;
		padding: var(--spacing-2) 0;
		border: 0;
		border-top: 1px solid var(--color-border-subtle);
		background: transparent;
		color: var(--color-text-secondary);
		font: inherit;
		font-size: var(--font-size-base);
		line-height: 1.45;
		text-align: left;
		cursor: pointer;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}

	.article-utility-action:last-child {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.article-utility-action:hover,
	.article-utility-action:focus-visible {
		color: var(--color-text);
		border-color: var(--color-accent);
	}

	.article-utility-action:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.article-utility-action[aria-pressed="true"] {
		color: var(--color-accent);
	}

	.article-utility-action svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
	}

	.article-utility-block {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.article-utility-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	.article-utility-value {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: 1.6;
	}

	:global(:lang(th)) .article-utility-action,
	:global(:lang(th)) .article-utility-label,
	:global(:lang(th)) .article-utility-value,
	:global(:lang(th)) .article-utility-byline-name,
	:global(:lang(th)) .article-utility-byline-role {
		font-family: var(--font-sans);
		font-style: normal;
		letter-spacing: 0;
	}

	:global(:lang(th)) .article-utility-action,
	:global(:lang(th)) .article-utility-label { font-size: .875rem; line-height: 1.55; }
	:global(:lang(th)) .article-utility-value,
	:global(:lang(th)) .article-utility-byline-name,
	:global(:lang(th)) .article-utility-byline-role { font-size: .875rem; line-height: 1.7; }

	@media (max-width: 1320px) {
		.article-utility-rail {
			display: grid;
			grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
			gap: var(--spacing-5);
			align-items: start;
			padding-bottom: var(--spacing-5);
			border-bottom: 1px solid var(--color-border-subtle);
		}

		.article-utility-actions {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--spacing-2);
			padding-bottom: 0;
			border-bottom: 0;
		}

		.article-utility-action,
		.article-utility-action:last-child {
			justify-content: center;
			padding-inline: var(--spacing-2);
			border: 1px solid var(--color-border-subtle);
			font-size: var(--font-size-sm);
		}
	}

	@media (max-width: 640px) {
		.article-utility-rail {
			display: block;
			padding-bottom: var(--spacing-4);
			border-bottom: 1px solid var(--color-border-subtle);
		}

		.article-utility-actions {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.article-utility-block {
			display: none;
		}

		.article-utility-action {
			flex-direction: column;
			gap: var(--spacing-1);
			min-height: 56px;
			text-align: center;
		}
	}

	.article-utility-bylines {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.article-utility-byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	.article-utility-avatar {
		width: var(--avatar-size-lg);
		height: var(--avatar-size-lg);
		border-radius: 999px;
		object-fit: cover;
	}

	.article-utility-byline-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.article-utility-byline-name {
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.article-utility-byline-role {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	:global(:lang(th)) .article-utility-label,
	:global(:lang(th)) .article-utility-byline-role {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-style: normal;
		letter-spacing: 0;
		line-height: 1.55;
		text-transform: none;
	}

</style>
